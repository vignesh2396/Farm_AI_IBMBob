# FarmAI Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control

# ──────────────────────────────────────────────────────────────────────────────
# LLM Configuration (Required)
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key — Get yours at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini model to use (optional - defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# LLM response creativity (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# Maximum tokens per LLM response
LLM_MAX_TOKENS=2048

# ──────────────────────────────────────────────────────────────────────────────
# Database Configuration (Optional - defaults shown)
# ──────────────────────────────────────────────────────────────────────────────

# Path to SQLite database file
DB_PATH=data/farmdata.db

# ──────────────────────────────────────────────────────────────────────────────
# RAG / Vector Store Configuration (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Directory where ChromaDB persists vector embeddings
CHROMA_PERSIST_DIR=data/chroma_db

# Directory containing agricultural knowledge base documents (.txt, .pdf)
DOCUMENTS_DIR=rag/documents

# Embedding model (Google Generative AI embeddings)
EMBEDDING_MODEL=models/embedding-001

# ──────────────────────────────────────────────────────────────────────────────
# Weather API Configuration (Optional - uses Open-Meteo free tier by default)
# ──────────────────────────────────────────────────────────────────────────────

# Open-Meteo weather forecast API URL (no API key required)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# How long to cache weather data (hours) before re-fetching
WEATHER_CACHE_TTL_HOURS=6

# Geocoding API for location → lat/lon conversion
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# ──────────────────────────────────────────────────────────────────────────────
# Data Files (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Path to crop reference CSV dataset
CROP_REFERENCE_CSV=data/crop_reference.csv

# Path to soil fertility classification rules JSON
SOIL_RULES_JSON=data/soil_fertility_rules.json

# ──────────────────────────────────────────────────────────────────────────────
# Logging Configuration (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=data/farmai.log

# Enable debug mode (shows extra trace info in UI)
DEBUG_MODE=false
